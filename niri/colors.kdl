layout {
    focus-ring {
        active-color "#ffb4a9"
        inactive-color "#b69995"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb4a9"
        inactive-color "#b69995"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb4a9"
        inactive-color "#b69995"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb4a980"
    }
}

