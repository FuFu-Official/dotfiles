" -----------------------------------------------------------------------------
" Zathura colors
" -----------------------------------------------------------------------------

set default-bg              "rgba(54, 2, 87, 1)"
set default-fg              "#e2b6ff"

set statusbar-bg            "#360257"
set statusbar-fg            "#e2b6ff"

set inputbar-bg             "#360257"
set inputbar-fg             "#e2b6ff"

set notification-error-bg   "#4b0002"
set notification-error-fg   "#ffb4ab"

set notification-warning-bg "#f3daff"
set notification-warning-fg "#da342e"

set highlight-color         "#f3daff"
set highlight-active-color  "#e2b6ff"

set completion-highlight-fg "#360257"
set completion-highlight-bg #e2b6ff""

set completion-bg           "#360257"
set completion-fg           "#e2b6ff"

set notification-bg         "#360257"
set notification-fg         "#e2b6ff"

set recolor                 "true"
set recolor-lightcolor      "rgba(54, 2, 87, 1)"
set recolor-darkcolor       "#e2b6ff"
set recolor-reverse-video   "true"
set recolor-keephue         "true"
