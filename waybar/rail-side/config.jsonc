{
  "include": [
    "modules.jsonc",
    "modules-dividers.jsonc",
  ],
  "layer": "top",
  "position": "left",
  "fixed-center": true,
  "reload_style_on_change": true,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 0,
  "margin-bottom": 4,
  "modules-left": [
    "custom/applauncher",
    "hyprland/workspaces",
  ],
  "modules-center": [
    "clock",
    "idle_inhibitor",
  ],
  "modules-right": [
    "custom/updates",
    "network",
    "bluetooth",
    "privacy",
    "power-profiles-daemon",
    "group/powermenu",
  ],
}

