{
  "include": [
    "modules.jsonc",
    "modules-dividers.jsonc",
  ],
  "layer": "top",
  "position": "bottom",
  "fixed-center": true,
  "reload_style_on_change": true,
  "margin-top": 0,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0,
  "modules-left": [
    "custom/applauncher",
    "hyprland/workspaces",
    "custom/media",
    "custom/updates",
    "custom/weather",
    "group/sysinfo",
  ],
  "modules-center": [
    "wlr/taskbar",
    "custom/cava",
  ],
  "modules-right": [
    "bluetooth",
    "network",
    "tray",
    "privacy",
    "group/tools",
    "group/audio",
    "battery",
    "clock",
    "group/powermenu",
  ],
}
